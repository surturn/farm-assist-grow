generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String         @id
  email             String         @unique
  firstName         String?
  lastName          String?
  phone             String?
  preferredLanguage String         @default("en")
  region            String?
  avatarUrl         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tenantMemberships TenantUser[]
  tasks             Task[]
  notifications     Notification[]
  scans             Scan[]
  farmNotes         FarmNote[]
  channel           FarmerChannel?
}

enum TenantType {
  FARM
  AGROVET
  SACCO
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  type        TenantType
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TenantUser[]
  farms       Farm[]
  agrovets    Agrovet[]
}

model TenantUser {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  role      Role     @default(MEMBER)
  joinedAt  DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

model Farm {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  location    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  crops       Crop[]
  tasks       Task[]
  scans       Scan[]
  notes       FarmNote[]
}

model Crop {
  id              String    @id @default(uuid())
  farmId          String
  name            String
  type            String
  plantedAt       DateTime?
  expectedHarvest DateTime?
  status          String    @default("GROWING") // GROWING, HARVESTED, DISEASED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  farm            Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(uuid())
  farmId      String?
  title       String
  description String?
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  assignedTo  String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  farm        Farm?     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  assignee    User?     @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  message   String
  type      String   @default("INFO") // ALERT, INFO
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Scan {
  id            String   @id @default(uuid())
  // Nullable: a scan can arrive from an unlinked WhatsApp number and is held
  // against the FarmerChannel until that farmer registers.
  userId        String?
  farmId        String?
  imageUrl      String?
  diseaseName   String?
  confidence    Float?
  treatment     String?
  createdAt     DateTime @default(now())

  // WhatsApp provenance. waMessageId is unique so a replayed Meta webhook
  // is a no-op: one field serves both provenance and idempotency.
  channelId     String?
  waMessageId   String?  @unique
  mediaId       String?
  workerVersion String?
  reviewStatus  String?  // null for API scans; PENDING/CLEARED/ESCALATED from the channel

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm          Farm?          @relation(fields: [farmId], references: [id], onDelete: SetNull)
  channel       FarmerChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
}

model FarmNote {
  id          String   @id @default(uuid())
  // Nullable: a farmer with more than one farm is asked once per session, so a
  // note can land before the farm is resolved.
  farmId      String?
  userId      String
  // Nullable: a voice note is the log entry itself, so `note` is empty when
  // audioUrl is set. No transcription is performed.
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channelId     String?
  waMessageId   String?  @unique
  audioUrl      String?
  workerVersion String?

  farm        Farm?          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     FarmerChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
}

model Agrovet {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  name          String
  location      String
  // E.164. The dashboard offers a "Contact Agrovet" action, and a
  // low-confidence diagnosis routes the farmer to a real person here.
  contactNumber String?
  // Null until a review mechanism exists. Callers must treat null as "no
  // rating" and show nothing — never substitute a default.
  rating        Float?
  // Unused in v1. Ships now so the v1.1 geospatial agrovet matching needs no
  // migration; v1 routes low-confidence scans by county-level region instead.
  latitude      Float?
  longitude     Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]
}

model Product {
  id          String   @id @default(uuid())
  agrovetId   String
  name        String
  description String?
  price       Float
  category    String   // SEED, FERTILIZER, PESTICIDE
  inStock     Boolean  @default(true)
  agrovet     Agrovet  @relation(fields: [agrovetId], references: [id], onDelete: Cascade)
}

/// A WhatsApp correspondent, keyed on their phone number rather than on an
/// account. The row exists from the farmer's very first message, before any
/// User does, which is what lets the first scan be answered without a signup.
model FarmerChannel {
  id       String  @id @default(uuid())
  phone    String  @unique // E.164, no spaces or punctuation
  userId   String? @unique // null until the farmer completes signup
  language String  @default("sw")

  // Four digits, hashed. Deliberately separate from the account password:
  // household phones are shared, and a PIN in chat history must not reach
  // the dashboard account.
  pinHash String?

  // One-time link carried into the website signup flow.
  linkToken          String?   @unique
  linkTokenExpiresAt DateTime?

  optedOut Boolean @default(false)

  // Load-bearing: the sender reads this to enforce Meta's 24-hour rule, so a
  // free-form send outside the window fails in code rather than at Meta.
  lastInboundAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  events    ChannelEvent[]
  scans     Scan[]
  farmNotes FarmNote[]
}

enum ChannelDirection {
  INBOUND
  OUTBOUND
}

/// Append-only log of everything that crossed the channel. Never updated,
/// never deleted while its channel lives. This is the evidence base for
/// debugging delivery failures and for defending the Meta quality rating.
model ChannelEvent {
  id          String           @id @default(uuid())
  channelId   String
  direction   ChannelDirection
  /// Dotted event name: message.image, message.text, message.audio,
  /// command.stop, status.delivered, status.failed.
  type        String
  waMessageId String?
  /// Pointer to where the body lives (storage key, Scan id, FarmNote id).
  /// The payload itself is not copied in here.
  payloadRef  String?
  /// Small structured extras only — template name, error code, category.
  /// Never message content, never credentials.
  metadata    Json?
  createdAt   DateTime         @default(now())

  channel FarmerChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([waMessageId])
}

model NewsItem {
  id          String   @id @default(uuid())
  title       String
  content     String
  source      String?
  category    String?  // SUBSIDY, ALERT, TENDER, GENERAL
  publishedAt DateTime @default(now())
}
